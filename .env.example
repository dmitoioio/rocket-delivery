# ── Supabase ────────────────────────────────────────────────────────────────
# Спільний проєкт із cstllife (CSTL_NEWS). НЕ створювати окремий проєкт —
# див. docs/adr/0001-shared-supabase-database.md
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Публічний anon-ключ. Він потрапляє у браузер — це нормально ЛИШЕ якщо
# на кожній таблиці ввімкнено RLS. Див. docs/05-roles-auth-rls.md
VITE_SUPABASE_ANON_KEY=

# service_role-ключ НІКОЛИ не потрапляє у фронтенд і не комітиться.
# Використовується тільки в Edge Functions / серверних скриптах.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Карти ───────────────────────────────────────────────────────────────────
# Тайли для Leaflet. Публічні тайли OSM заборонені для продакшену їхньою
# usage policy — потрібен свій провайдер. Див. docs/adr/0007-maps-provider.md
VITE_MAP_TILES_URL=
VITE_MAP_TILES_KEY=

# Google Directions/Geocoding API (платний, з обмеженням по домену й API).
# Замінює безкоштовний embed-хак прототипу.
VITE_GOOGLE_MAPS_KEY=

# ── Операційні параметри (значення за замовчуванням, конфігуруються в БД) ────
# Радіус доставки в кілометрах від закладу, за межами якого замовлення не приймається
VITE_MAX_DELIVERY_RADIUS_KM=15
# Скільки замовлень одночасно може вести один курʼєр (1 у MVP, >1 = батчинг)
VITE_MAX_ACTIVE_ORDERS_PER_COURIER=1

# ── Середовище ──────────────────────────────────────────────────────────────
# development | staging | production
VITE_APP_ENV=development
